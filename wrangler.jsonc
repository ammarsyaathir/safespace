{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "itt588-safespace-my",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html", "**/*.txt"],
      "fallthrough": true
    }
  ]
}
